{
  "name": "neverquest",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "description": "A local ledger companion for Monsters & Memories",
  "author": "Neverquest contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisDShaw/neverquest.git"
  },
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --experimental-test-isolation=none",
    "check": "node scripts/check.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "build:icon": "node scripts/icon.mjs",
    "build:prepare": "npm run build:icon && node scripts/notices.mjs",
    "dist": "npm run build:prepare && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "dist:dir": "npm run build:prepare && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "release:checksums": "node scripts/checksums.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.15.7"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
